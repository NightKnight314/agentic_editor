{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nighthack.local/style-map.schema.json",
  "title": "Nighthack Style Map",
  "type": "object",
  "required": ["id", "version", "name", "output", "storyBeats", "plannerRules", "review"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "output": { "type": "object" },
    "creativeThesis": { "type": "object" },
    "storyBeats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "range", "purpose", "rules"],
        "properties": {
          "id": { "type": "string" },
          "range": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "purpose": { "type": "string" },
          "selectionSignals": { "type": "array", "items": { "type": "string" } },
          "rules": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "pacing": { "type": "object" },
    "visual": { "type": "object" },
    "typography": { "type": "object" },
    "audio": { "type": "object" },
    "plannerRules": { "type": "array", "items": { "type": "string" } },
    "review": {
      "type": "object",
      "required": ["passScore", "criteria"],
      "properties": {
        "passScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "criteria": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "additionalProperties": true
}
